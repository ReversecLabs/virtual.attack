---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { parseTestCase } from '../utils/parseTestCase';

const entries = await getCollection('test-cases');
const techniques = entries
  .map(e => parseTestCase(e.body, e.slug))
  .sort((a, b) => a.component.localeCompare(b.component) || a.title.localeCompare(b.title));

const components = [...new Set(techniques.map(t => t.component))].sort();
const countByComponent = Object.fromEntries(
  components.map(c => [c, techniques.filter(t => t.component === c).length])
);
---

<Layout title="Virtual//Attack">
  <div class="hero-band">
    <section class="hero">
      <div class="hero-body">
        <h1 class="hero-title">
          VMware threat emulation techniques.
        </h1>
        <p class="hero-lead">
          A reproducible catalogue of <strong>{techniques.length} atomic actions</strong> against vCenter, ESXi, SDDC Manager, and the wider VCF ecosystem — sourced from threat intelligence reporting, mapped to MITRE&nbsp;ATT&amp;CK, and paired with the log sources where evidence is expected.
        </p>
      </div>
    </section>
  </div>

  <main>
    <div class="controls">
      <span class="controls-label">Filter</span>
      <div class="filter-chips" id="filter-chips">
        <button class="chip active" data-component="all">
          All <span class="chip-count">{techniques.length}</span>
        </button>
        {components.map(comp => (
          <button class="chip" data-component={comp}>
            {comp} <span class="chip-count">{countByComponent[comp]}</span>
          </button>
        ))}
      </div>
    </div>

    <p class="results-count" id="results-count">
      <span class="dot"></span>
      <strong id="results-n">{techniques.length}</strong>
      <span>techniques shown</span>
    </p>
    <div class="grid" id="technique-grid"></div>
  </main>
</Layout>

<script define:vars={{ techniques }}>
  // Component palette — harmonised with deep-purple + lime theme
  var COMP_COLORS = {
    'ESXi':                              '#B6F528',
    'vCenter':                           '#8b5cf6',
    'SDDC Manager':                      '#4ecdc4',
    'AD':                                '#ffb74d',
    'VCF Automation':                    '#4fc3f7',
    'VCF Operations for Logs':           '#f06292',
  };

  // Actor tag palette — muted, sits well on white cards
  var ACTOR_PALETTE = [
    '#7c5cff', '#3a7ca5', '#2ecc71', '#d97706',
    '#9b59b6', '#1abc9c', '#e67e22', '#c0392b'
  ];

  function compColor(comp) {
    if (!comp) return '#6b5a78';
    for (var key in COMP_COLORS) {
      if (comp.toLowerCase().includes(key.toLowerCase())) return COMP_COLORS[key];
    }
    if (/workspace|vidm|identity/i.test(comp)) return '#80cbc4';
    return '#6b5a78';
  }

  function actorColor(name) {
    var h = 0;
    for (var i = 0; i < name.length; i++) h = ((h * 31) + name.charCodeAt(i)) | 0;
    return ACTOR_PALETTE[Math.abs(h) % ACTOR_PALETTE.length];
  }

  function esc(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderCard(tc) {
    var color = compColor(tc.component);
    var actors = tc.threatActors.slice(0, 3).map(function(a) {
      var c = actorColor(a);
      return '<span class="actor-tag" style="background:' + c + '14;border:1px solid ' + c + '55;color:' + c + '">' + esc(a) + '</span>';
    }).join('');
    var moreActors = tc.threatActors.length > 3
      ? '<span class="actor-more">+' + (tc.threatActors.length - 3) + '</span>'
      : '';
    var desc = esc(tc.description.replace(/\n/g, ' ').slice(0, 220));

    return '<a href="/techniques/' + tc.slug + '" class="technique-card">'
      + '<div class="card-header">'
      + '<span class="component-badge" style="background:' + color + '1f;border:1px solid ' + color + '66;color:' + color + '">' + esc(tc.component) + '</span>'
      + '<span class="mitre-id">' + esc(tc.mitreId) + '</span>'
      + '</div>'
      + '<h3 class="card-title">' + esc(tc.title) + '</h3>'
      + (tc.tactic ? '<p class="card-tactic">' + esc(tc.tactic) + '</p>' : '')
      + (desc ? '<p class="card-desc">' + desc + '</p>' : '')
      + (tc.threatActors.length ? '<div class="card-actors">' + actors + moreActors + '</div>' : '')
      + '</a>';
  }

  var activeComponent = 'all';
  var searchTerm = '';

  function matches(tc) {
    if (activeComponent !== 'all' && tc.component !== activeComponent) return false;
    if (!searchTerm) return true;
    var q = searchTerm.toLowerCase();
    return (
      tc.title.toLowerCase().includes(q) ||
      tc.description.toLowerCase().includes(q) ||
      tc.component.toLowerCase().includes(q) ||
      tc.tactic.toLowerCase().includes(q) ||
      tc.mitreId.toLowerCase().includes(q) ||
      tc.author.toLowerCase().includes(q) ||
      tc.threatActors.some(function(a) { return a.toLowerCase().includes(q); })
    );
  }

  function renderGrid() {
    var filtered = techniques.filter(matches);
    var grid = document.getElementById('technique-grid');
    var n = document.getElementById('results-n');
    if (grid) {
      grid.innerHTML = filtered.length
        ? filtered.map(renderCard).join('')
        : '<p class="no-results">No techniques match your search.</p>';
    }
    if (n) n.textContent = filtered.length;
  }

  // Search bar (in Layout's header)
  var searchInput = document.getElementById('global-search');
  if (searchInput) {
    var params = new URLSearchParams(window.location.search);
    var q = params.get('q');
    if (q) { searchInput.value = q; searchTerm = q; }

    var debounce;
    searchInput.addEventListener('input', function() {
      clearTimeout(debounce);
      debounce = setTimeout(function() {
        searchTerm = searchInput.value.trim();
        renderGrid();
      }, 180);
    });
  }

  // Filter chips
  var chips = document.getElementById('filter-chips');
  if (chips) {
    chips.addEventListener('click', function(e) {
      var chip = e.target.closest('.chip');
      if (!chip) return;
      document.querySelectorAll('.chip').forEach(function(c) { c.classList.remove('active'); });
      chip.classList.add('active');
      activeComponent = chip.dataset.component;
      renderGrid();
    });
  }

  renderGrid();
</script>
